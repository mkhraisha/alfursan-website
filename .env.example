# ─────────────────────────────────────────────────────────
# Environment Variables — Alfursan Auto
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────
# Injected automatically by the Supabase Vercel connector.
# Add manually if not using the connector.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ── Resend (email notifications) ─────────────────────────
# Server-only
RESEND_API_KEY=
# The verified sender address (must match a domain verified in Resend)
RESEND_FROM_ADDRESS=noreply@alfursanauto.ca
# Dealer inbox that receives "new application" notifications
RESEND_DEALER_EMAIL=

# ── Upstash Redis (rate limiting) ────────────────────────
# Server-only
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Google Gemini (AI-generated vehicle descriptions) ────
# Server-only. Free API key from https://aistudio.google.com/apikey — no credit card required.
GEMINI_API_KEY=
# Optional override; defaults to a current free-tier-eligible Gemini model if unset
GEMINI_MODEL=gemini-flash-latest

# ── Vercel API (admin "Refresh Public Cache" button) ─────
# Server-only. Powers POST /api/admin/refresh-cache, which purges the CDN
# cache for the public GET /api/vehicles response. Without these set, the
# button returns a clear "not configured" error instead of crashing.
# Token: https://vercel.com/account/tokens
VERCEL_API_TOKEN=
# NOT set here — Vercel already injects VERCEL_PROJECT_ID automatically at
# build+runtime (a system env var; check "Enable access to System
# Environment Variables" in Project Settings if it's ever missing).
# Only needed if the project is owned by a team, not a personal account.
# Found in Team Settings → General → Team ID.
VERCEL_TEAM_ID=

# ── Sentry (error monitoring) ─────────────────────────────
# DSN from Project Settings → Client Keys in your Sentry dashboard
SENTRY_DSN=
# Auth token from User Settings → Auth Tokens (needs project:releases + org:read scopes)
# Used only at build time to upload source maps — never sent to the browser
SENTRY_AUTH_TOKEN=
