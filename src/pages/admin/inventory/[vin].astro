---
export const prerender = false;

import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getAdminClient } from "../../../lib/supabase-admin";
import { can } from "../../../lib/permissions";
import VehicleDetail from "../../../components/admin/VehicleDetail";
import type { VehicleFull, VehicleExpense, VehicleDoc, UserProfile } from "../../../components/admin/VehicleDetail";

const { vin } = Astro.params;
const { adminRole } = Astro.locals;
const canSeeFinancials = can(adminRole, "vehicles:financials:read");

if (!vin) return Astro.redirect("/admin/inventory/");

const db = getAdminClient();

// A dedicated branch per role (rather than a shared, conditionally-selected
// query) keeps each `.select()` call a single string literal, which Supabase's
// type-level query parser needs to infer a real row type instead of falling
// back to a ParserError.
const usersQuery = canSeeFinancials
  ? db.from("user_profiles").select("id, email, commission_percentage").eq("is_active", true).order("email", { ascending: true })
  : db.from("user_profiles").select("id, email").eq("is_active", true).order("email", { ascending: true });

const [vehicleRes, expensesRes, docsRes, usersRes] = await Promise.all([
  db.from("vehicles").select("*").eq("vin", vin).single(),
  db.from("vehicle_expenses").select("id, category, description, amount, receipt_file_path, reimbursed, vendor, expense_date, tax_amount, tax_type, tax_rate, created_at").eq("vin", vin).order("created_at", { ascending: true }),
  db.from("vehicle_documents").select("id, document_type, file_path, description, created_at").eq("vin", vin).order("created_at", { ascending: true }),
  usersQuery,
]);

if (!vehicleRes.data) return Astro.redirect("/admin/inventory/");

const vehicleData = vehicleRes.data as VehicleFull;
const vehicle = canSeeFinancials
  ? vehicleData
  : {
      ...vehicleData,
      purchase_price: null,
      sale_price: null,
      wholesale_price: null,
      advertised_price_cargurus: null,
      advertised_price_facebook: null,
    };
const expenses  = (expensesRes.data ?? []) as VehicleExpense[];
const documents = (docsRes.data ?? []) as VehicleDoc[];
const users = ((usersRes.data ?? []) as UserProfile[]).map((u) =>
  canSeeFinancials ? u : { ...u, commission_percentage: null }
);

const supabaseUrl = import.meta.env.SUPABASE_URL as string;
const pageTitle   = [vehicle.year, vehicle.make, vehicle.model].filter(Boolean).join(" ") || vin;
---

<AdminLayout title={pageTitle} activeNav="inventory">
  <VehicleDetail
    vehicle={vehicle}
    expenses={expenses}
    documents={documents}
    users={users}
    supabaseUrl={supabaseUrl}
    client:load
  />
</AdminLayout>
