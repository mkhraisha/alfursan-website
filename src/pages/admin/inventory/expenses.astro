---
export const prerender = false;
import AdminLayout from "../../../layouts/AdminLayout.astro";
import AllExpenses from "../../../components/admin/AllExpenses";
import type { AllExpensesRow } from "../../../components/admin/AllExpenses";
import { getAdminClient } from "../../../lib/supabase-admin";
import { can } from "../../../lib/permissions";

const { adminRole } = Astro.locals;
if (!can(adminRole, "vehicles:financials:read")) {
  return Astro.redirect("/admin/?error=unauthorized");
}

const db = getAdminClient();
const { data, error } = await db
  .from("vehicle_expenses")
  .select("id, vin, category, description, amount, vendor, expense_date, reimbursed, tax_amount, tax_type, tax_rate, created_at, vehicles(make, model, year)")
  .order("expense_date", { ascending: false, nullsFirst: false })
  .order("created_at", { ascending: false });

if (error) console.error("[admin/inventory/expenses]", error);

const expenses = (data ?? []) as unknown as AllExpensesRow[];
---

<AdminLayout title="All Expenses" activeNav="inventory">
  <AllExpenses expenses={expenses} client:load />
</AdminLayout>
