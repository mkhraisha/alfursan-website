---
/**
 * OAuth callback handler. Supabase redirects here after magic-link click.
 * Exchanges the URL fragment token for a session cookie, then redirects to dashboard.
 */
export const prerender = false;
const SUPABASE_URL = import.meta.env.SUPABASE_URL ?? "";
const SUPABASE_PUBLISHABLE_KEY = import.meta.env.SUPABASE_PUBLISHABLE_KEY ?? "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Signing in… — Alfursan Admin</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: 'Inter', sans-serif;
        background: #f0f2f5;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #1a1d23;
      }
      .message {
        text-align: center;
        font-size: 16px;
        color: #99a1b2;
      }
      .message strong { display: block; font-size: 20px; color: #1a1d23; margin-bottom: 8px; }
    </style>
  </head>
  <body>
    <p class="message" id="msg"><strong>Verifying…</strong>Please wait while we sign you in.</p>

    <div id="supabase-config" data-url={SUPABASE_URL} data-key={SUPABASE_PUBLISHABLE_KEY} hidden></div>

    <script>
      import { createClient } from "@supabase/supabase-js";

      const config = document.getElementById("supabase-config") as HTMLElement;
      const supabaseUrl = config.dataset.url ?? "";
      const supabaseKey = config.dataset.key ?? "";
      const msg = document.getElementById("msg") as HTMLElement;

      if (!supabaseUrl || !supabaseKey) {
        msg.innerHTML = '<strong style="color:#B92111">Sign-in unavailable.</strong><br>Supabase auth config is missing.';
      } else {
        const supabase = createClient(supabaseUrl, supabaseKey);
        let done = false;

        async function completeSignIn(session: {
          access_token: string;
          expires_in?: number;
          refresh_token?: string | null;
          expires_at?: number;
        }) {
          if (done) return;
          done = true;
          const res = await fetch("/api/admin/set-session", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              token: session.access_token,
              expiresIn: session.expires_in ?? 28800,
              refreshToken: session.refresh_token ?? undefined,
              expiresAt: session.expires_at,
            }),
          });
          if (!res.ok) {
            msg.innerHTML = '<strong style="color:#B92111">Sign-in error.</strong><br><a href="/admin/" style="color:#B92111">Try again</a>';
            return;
          }
          window.location.replace("/admin/dashboard/");
        }

        const { data: { subscription } } = supabase.auth.onAuthStateChange(async (event, session) => {
          if (event === "SIGNED_IN" && session?.access_token) {
            subscription.unsubscribe();
            await completeSignIn(session);
          }
        });

        // Fallback for cases where SIGNED_IN event is delayed/missed.
        queueMicrotask(async () => {
          if (done) return;
          const { data } = await supabase.auth.getSession();
          if (data.session?.access_token) {
            subscription.unsubscribe();
            await completeSignIn(data.session);
          }
        });

        // Safety timeout in case sign-in never materializes.
        setTimeout(() => {
          if (done) return;
          subscription.unsubscribe();
          if (!window.location.hash.includes("access_token")) {
            msg.innerHTML = '<strong style="color:#B92111">Sign-in failed.</strong><br><a href="/admin/" style="color:#B92111">Try again</a>';
            return;
          }
          msg.innerHTML = '<strong style="color:#B92111">Sign-in timed out.</strong><br><a href="/admin/" style="color:#B92111">Try again</a>';
        }, 12_000);
      }
    </script>
  </body>
</html>
