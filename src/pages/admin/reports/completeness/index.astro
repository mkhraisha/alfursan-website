---
export const prerender = false;

import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { getAdminClient } from "../../../../lib/supabase-admin";
import { can } from "../../../../lib/permissions";
import { computeCompletenessReport, type CompletenessVehicleInput } from "../../../../lib/vehicles";

const { adminRole } = Astro.locals;
if (!can(adminRole, "reports:read")) {
  return Astro.redirect("/admin/?error=unauthorized");
}

const db = getAdminClient();

const { data: rawVehicles } = await db
  .from("vehicles")
  .select("vin, make, model, year, status, sale_date, description, images_json, advertised_price_cargurus, trim, engine_type, drive_type, transmission, fuel_type, cylinders, doors, colour, purchased_from_name, purchased_from_address")
  .order("created_at", { ascending: false });

const vehicles: CompletenessVehicleInput[] = (rawVehicles ?? []).map((v: Record<string, unknown>) => ({
  vin: v.vin as string,
  make: v.make as string,
  model: v.model as string,
  year: v.year as number,
  status: v.status as string | null,
  sale_date: v.sale_date as string | null,
  description: v.description,
  images_json: v.images_json,
  advertised_price_cargurus: v.advertised_price_cargurus,
  trim: v.trim,
  engine_type: v.engine_type,
  drive_type: v.drive_type,
  transmission: v.transmission,
  fuel_type: v.fuel_type,
  cylinders: v.cylinders,
  doors: v.doors,
  colour: v.colour,
  purchased_from_name: v.purchased_from_name,
  purchased_from_address: v.purchased_from_address,
}));

const report = computeCompletenessReport(vehicles);

const CATEGORY_LABELS: Record<string, string> = {
  compliance: "Compliance",
  listing: "Listing",
  spec: "Spec",
};

function fmtStatus(s: string | null) {
  if (!s) return "—";
  return s.replace(/_/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
}
---

<AdminLayout title="Data Completeness Report" activeNav="reports">
  <div class="page-header">
    <div>
      <a href="/admin/reports/" class="back-link">← Reports</a>
      <h1>Data Completeness Report</h1>
      <p>Vehicles missing fields they should have filled in — recomputed live from current inventory</p>
    </div>
  </div>

  <div class="stat-grid">
    <div class="stat-card">
      <span class="stat-card__label">Active Vehicles</span>
      <span class="stat-card__value" style="color:#1a1d23">{report.activeVehicles}</span>
    </div>
    <div class="stat-card">
      <span class="stat-card__label">Active Vehicles With Gaps</span>
      <span class="stat-card__value" style="color:#1a1d23">
        {report.rows.filter((r) => r.active).length}
      </span>
    </div>
    <div class="stat-card">
      <span class="stat-card__label">Avg Missing Fields / Active Vehicle</span>
      <span class="stat-card__value" style={`color:${report.averageMissingActive > 0 ? "#b92111" : "#1a7f4b"}`}>
        {report.averageMissingActive}
      </span>
    </div>
  </div>

  <div class="section">
    <div class="section__header">
      <h2>Most Common Gaps (Active Inventory)</h2>
    </div>

    {report.fieldFrequency.every((f) => f.missingCount === 0) ? (
      <div class="empty">No gaps found — every active vehicle has all tracked fields filled in.</div>
    ) : (
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>Field</th>
              <th>Category</th>
              <th>Missing</th>
              <th>% of Active Inventory</th>
            </tr>
          </thead>
          <tbody>
            {report.fieldFrequency.filter((f) => f.missingCount > 0).map((f) => (
              <tr>
                <td><strong>{f.label}</strong></td>
                <td><span class={`chip chip-${f.category}`}>{CATEGORY_LABELS[f.category]}</span></td>
                <td>{f.missingCount}</td>
                <td>{f.missingPct}%</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>

  <div class="section">
    <div class="section__header">
      <h2>Vehicles With Missing Fields</h2>
    </div>

    {report.rows.length === 0 ? (
      <div class="empty">No vehicles have missing fields.</div>
    ) : (
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>VIN</th>
              <th>Vehicle</th>
              <th>Status</th>
              <th>Missing Fields</th>
            </tr>
          </thead>
          <tbody>
            {report.rows.map((r) => (
              <tr>
                <td><a href={`/admin/inventory/${r.vin}/`} class="vin-link">{r.vin}</a></td>
                <td>{r.year} {r.make} {r.model}</td>
                <td>{r.active ? fmtStatus(r.status) : "Sold"}</td>
                <td>
                  <div class="chip-row">
                    {r.missingFields.map((f) => (
                      <span class={`chip chip-${f.category}`}>{f.label}</span>
                    ))}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
</AdminLayout>

<style>
  .page-header { margin-bottom: 28px; }
  .page-header h1 { font-size: 24px; font-weight: 800; color: #1a1d23; margin-top: 6px; }
  .page-header p { color: #99a1b2; font-size: 14px; margin-top: 4px; }
  .back-link { font-size: 13px; color: #B92111; font-weight: 500; }

  .stat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin-bottom: 32px;
  }
  .stat-card {
    background: #fff;
    border: 1px solid #e4e7ec;
    border-radius: 10px;
    padding: 20px 24px;
  }
  .stat-card__label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    color: #99a1b2;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 8px;
  }
  .stat-card__value { font-size: 36px; font-weight: 800; }

  .section {
    background: #fff;
    border: 1px solid #e4e7ec;
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 24px;
  }
  .section__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid #e4e7ec;
  }
  .section__header h2 { font-size: 16px; font-weight: 700; color: #1a1d23; }

  .empty { padding: 24px 20px; color: #99a1b2; font-size: 14px; }

  .table-wrap { overflow-x: auto; }
  .table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  .table th {
    text-align: left;
    padding: 10px 16px;
    font-size: 11px;
    font-weight: 700;
    color: #99a1b2;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid #e4e7ec;
    white-space: nowrap;
  }
  .table td {
    padding: 12px 16px;
    border-bottom: 1px solid #f0f2f5;
    color: #1a1d23;
    vertical-align: middle;
  }
  .table tr:last-child td { border-bottom: none; }
  .table tr:hover td { background: #f7f9fd; }

  .vin-link {
    color: #B92111;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chip {
    display: inline-block;
    padding: 3px 9px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
    white-space: nowrap;
  }
  .chip-compliance { background: #fdecea; color: #b13a30; }
  .chip-listing    { background: #fdf3e3; color: #a8571c; }
  .chip-spec       { background: #eef1f8; color: #445; }
</style>
